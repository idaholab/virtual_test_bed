#ifdef __okl__

#include "pb67.oudf"

#endif

void clipt()
{
  auto mesh = nrs->scalar->mesh("temperature");
  cliptOKL(mesh->Nelements, nrs->scalar->o_solution("temperature"));
}

/* UDF Functions */

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
}

void UDF_Setup()
{
}

void UDF_ExecuteStep(double time, int tstep)
{
  clipt();
  if (nrs->checkpointStep) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
  }
}
