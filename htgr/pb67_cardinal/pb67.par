[GENERAL]
polynomialOrder = 7
#startFrom = "restart.fld"
stopAt = endTime
endTime = 500

dt = 1.0e-05
timeStepper = tombo2
advectionSubCyclingSteps = 2

writeControl = steps
writeInterval = 500

regularization = hpfrt + nModes=2 + scalingCoeff=0.2/${dt}

scalars = temperature

[FLUID PRESSURE]
residualTol = 1e-04
preconditioner = multigrid
smootherType = chebyshev+jac
initialGuess = projectionAconj + nVector = 30

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet, zeroDirichlet
density = 1.0
viscosity = -1460.0
residualTol = 1e-06

[SCALAR TEMPERATURE]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann, udfNeumann
residualTol = 1e-06
rhoCp = 1.0
conductivity = -1036.0
