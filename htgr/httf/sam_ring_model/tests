[Tests]
  # Syntax Check
  [rings_syntax]
    type = RunApp
    input = 'HTTF-SS.i'
    check_input = True
    capabilities = 'bluecrabapp | samapp'
    cli_args = '--app SamApp'
  []

  # Regression test
  [rings]
    type = CSVDiff
    input = 'HTTF-SS.i'
    csvdiff = HTTF-SS_csv.csv
    prereq = rings_syntax
    # The result changes by at most 3e-6 over 1, 2, 4 and 8 ranks and for
    # nl_rel_tol = nl_abs_tol = l_tol = 1e-8, and by 1.1e-4 for dtmax = 900 instead of 3600.
    # R54_E and R54C_T_in (RCCS air inlet, where the channel velocity of about 0.008 m/s is below
    # the SUPG buoyancy velocity floor of about 0.18 m/s) change by 3.8e-3 and 1.1e-3 with
    # GlobalParams/buoyancy_supg = false. This is an O(h) stabilization effect, so these two
    # columns follow the SUPG stabilization scheme.
    cli_args = '--app SamApp Outputs/csv/sync_times=0.0 Outputs/csv/sync_only=true'
    capabilities = 'bluecrabapp | samapp'
    rel_err = 1e-3
    min_parallel = 4
    # Timed out in devel at 300s
    max_time = 500
  []
[]
