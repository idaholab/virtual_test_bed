[Tests]
  issues = '#135'
  # Regression tests
  [core_multiphysics]
    type = CSVDiff
    working_directory = 'inputs'
    input = HTTF_PG26_multiapp.i
    csvdiff = hpc_HTTF_PG26_transient.csv
    cli_args = '--distributed-mesh Executioner/num_steps=50 Outputs/file_base=hpc_HTTF_PG26_transient'
    allow_warnings = true
    min_parallel = 24
    # 24 cores, 29 time steps in 1 hour
    # 24 cores, 50 time steps in 5680s
    max_time = 7200
    capabilities = 'method=opt & relap7app'

    # Adjusted tolerance to avoid regolding. Regold on next larger diff
    rel_err = '6e-5'
    ignore_columns = 'upcomer_outlet_main'
  []
[]
