[GENERAL]
polynomialOrder = 3
#startFrom = "httf.run01"+time=0
startFrom = httf.run03
stopAt = endTime
endTime = 6
#numSteps = 5
dt = targetCFL=4 + initial=1e-5
timeStepper = tombo2
scalars = temperature, k, tau
writeControl = simulationTime 
writeInterval = 0.1

#verbose=true

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroDirichlet, zeroNeumann
residualTol = 1e-06
density = 1.0
viscosity = -104331.27 

[SCALAR TEMPERATURE]
#solver = none
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-06
rhoCp = 1.0
conductivity = -69683.01 

[SCALAR K]
boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann
residualTol = 1e-06
transportCoeff = 1.0
diffusionCoeff = -104331.27

[SCALAR TAU]
boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann
residualTol = 1e-06
transportCoeff = 1.0
diffusionCoeff = -104331.27
