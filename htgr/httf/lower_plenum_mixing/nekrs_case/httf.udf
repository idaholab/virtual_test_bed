//
// nekRS User Defined File
//
#include "RANSktau.hpp"
#include "tavg.hpp"

std::unique_ptr<nrs_t::tavgLegacy_t> avg;

#ifdef __okl__

#include "httf.oudf"

#endif

void userq(double time)
{
  RANSktau::updateSourceTerms();
}

void uservp(double time)
{
  auto mesh = nrs->meshV;

  RANSktau::updateProperties();

  dfloat conductivity;
  platform->options.getArgs("SCALAR00 DIFFUSIVITY", conductivity);
  const dfloat Pr_t = 0.91;
  scalarScaledAdd(mesh->Nlocal, conductivity, 1/Pr_t, RANSktau::o_mue_t(), nrs->scalar->o_diffusionCoeff("temperature"));
}

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
}

void UDF_Setup()
{
  avg = std::make_unique<nrs_t::tavgLegacy_t>();

  auto mesh = nrs->meshV;

  nrs->userProperties = &uservp;
  nrs->userSource = &userq;

  RANSktau::setup(nrs->scalar->nameToIndex.find("k")->second);

  //Inlet condition
  auto& o_usrwrk = platform->app->bc->o_usrwrk;
  o_usrwrk.resize(4*nrs->fieldOffset);
  o_usrwrk.copyFrom(nek::ptr<double>("vin"), mesh->Nlocal, 0*nrs->fieldOffset);
  o_usrwrk.copyFrom(nek::ptr<double>("t1in"), mesh->Nlocal, 1*nrs->fieldOffset);
  o_usrwrk.copyFrom(nek::ptr<double>("t2in"), mesh->Nlocal, 2*nrs->fieldOffset);
  o_usrwrk.copyFrom(nek::ptr<double>("t3in"), mesh->Nlocal, 3*nrs->fieldOffset);
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (nrs->timeStepConverged) {
    avg->run(time);
  }

  auto mesh = nrs->meshV;

  cliptOKL(mesh->Nelements, nrs->scalar->o_solution("temperature"));

  if ((tstep%1000)==0){
    nrs->copyToNek(time, tstep);
    nek::userchk();
  }

  if (nrs->checkpointStep) {
    avg->writeToFile(mesh);
  }

  if (nrs->lastStep) avg.reset();
}
