@kernel void scalarScaledAdd(const dlong N,
                             const dfloat a,
                             const dfloat b,
                             @restrict const dfloat* X,
                             @restrict dfloat* Y)
{
  for(dlong n = 0; n < N; ++n; @tile(256,@outer,@inner))
    if(n < N)
      Y[n] = a + b * X[n];
}

@kernel void cliptOKL(const dlong Nelements,
                   @restrict dfloat * TEMP)
{
 for(dlong e=0;e<Nelements;++e;@outer(0)){
   for(int n=0;n<p_Np;++n;@inner(0)){
     const int id = e*p_Np + n;
     if(TEMP[id]>1.0)
          {
          TEMP[id] = 1.0;
          }
     if(TEMP[id]<0.0)
          {
          TEMP[id] = 0.0;
          }
   }
 }
}

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = bc->usrwrk[bc->idxVol + 0*bc->fieldOffset];
    bc->uzFluid = 0.0;
  }
  else {
    bc->sScalar = 0;
    if(bc->id==1){
      if(isField("scalar temperature")) bc->sScalar = bc->usrwrk[bc->idxVol + 1*bc->fieldOffset];
      if(isField("scalar k")) bc->sScalar = bc->usrwrk[bc->idxVol + 2*bc->fieldOffset];
      if(isField("scalar tau")) bc->sScalar = bc->usrwrk[bc->idxVol + 3*bc->fieldOffset];
    }
  }
}
