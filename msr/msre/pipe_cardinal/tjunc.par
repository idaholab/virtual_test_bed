[GENERAL] 
startFrom = tjunc.old+u+p
polynomialOrder = 5

numSteps = 50000
dt = 1e-04
writeInterval = 5000

timeStepper = tombo2
regularization = hpfrt + nModes = 1 + scalingCoeff = 20
scalars = temperature

[FLUID PRESSURE]
residualTol = 1e-06

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann, zeroDirichlet
residualTol = 1e-08

[SCALAR TEMPERATURE]
boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann, zeroNeumann
mesh = fluid + solid
residualTol = 1e-08
