[Tests]
  [mesh_syntax]
    type = RunApp
    working_directory = '../mesh'
    input = 'mesh.i'
    # mesh.i has no Executioner, so --mesh-only is needed; with check_input the mesh is built but
    # not written
    cli_args = '--mesh-only'
    check_input = True
    capabilities = 'blackbearapp'
  []
  # Chained regression tests for the welding -> cooldown pipeline (abbreviated runs).
  # The full simulation (3857 + 206 time steps, about 11.8 h on 20 ranks) is not tested here; its
  # results are kept as reference in welding/gold/weld_full_scl.csv and
  # cooldown/gold/cooldown_full_scl.csv.
  #
  # The model's *_id, *_od and Tc_mid probes (x = 75, 95, 115 mm at y = 600 mm, z = 0) lie in weld
  # passes 1, 3-6 and 7-8, which are not yet deposited at t = 50 s (they are activated at
  # t = 587.5, 2987.5 and 7785 s in the full run), so these columns are zero in both abbreviated gold
  # files. The abbreviated tests therefore add five PointValue probes near the start of pass 1,
  # where the torch has passed by t = 50 s:
  #   *_haz:  heat-affected base metal, (-75.78, 592.41, -5.96), active from t = 0
  #   *_weld: weld metal of pass 1, (-75.78, 598.68, -5.96), active from t = 17.5 s
  [weld_syntax]
    type = RunApp
    input = 'weld.i'
    check_input = True
    capabilities = 'blackbearapp'
  []
  [weld_abbrev]
    # 20 time steps to t = 50 s: delay period plus the first 25 s of pass 1 (torch on, element
    # activation). t = 50 s is a sync time, so the final step is checkpointed and the last CSV row
    # and the last checkpoint belong to the same time, as the cooldown restart requires.
    type = CSVDiff
    input = 'weld.i'
    cli_args = "Executioner/num_steps=20 Outputs/exodus/enable=false
                Postprocessors/T_haz/type=PointValue Postprocessors/T_haz/variable=T Postprocessors/T_haz/point='-75.78 592.41 -5.96'
                Postprocessors/Svm_haz/type=PointValue Postprocessors/Svm_haz/variable=vonmises_stress Postprocessors/Svm_haz/point='-75.78 592.41 -5.96'
                Postprocessors/eps_p_haz/type=PointValue Postprocessors/eps_p_haz/variable=effective_plastic_strain Postprocessors/eps_p_haz/point='-75.78 592.41 -5.96'
                Postprocessors/T_weld/type=PointValue Postprocessors/T_weld/variable=T Postprocessors/T_weld/point='-75.78 598.68 -5.96'
                Postprocessors/eps_p_weld/type=PointValue Postprocessors/eps_p_weld/variable=effective_plastic_strain Postprocessors/eps_p_weld/point='-75.78 598.68 -5.96'"
    csvdiff = '40mm/scl.csv'
    rel_err = 1e-5
    abs_zero = 1e-9
    # the cooldown restarts from this checkpoint, which requires the same number of ranks
    min_parallel = 12
    max_parallel = 12
    max_time = 900
    capabilities = 'method=opt & blackbearapp'
    prereq = 'weld_syntax'
  []
  [cooldown_syntax]
    type = RunApp
    working_directory = '../cooldown'
    input = 'cooldown.i'
    check_input = True
    # the mesh is read from the welding checkpoint written by weld_abbrev
    min_parallel = 12
    max_parallel = 12
    capabilities = 'method=opt & blackbearapp'
    prereq = 'weld_abbrev'
  []
  [cooldown_abbrev]
    # Restart from the final weld_abbrev checkpoint (../welding/40mm/weld_cp/LATEST) with the
    # bottom-node displacement BCs read from ../welding/40mm/scl.csv (no values passed here):
    # exercises the complete MOOSE-native welding -> cooldown transfer. The three PointValue
    # postprocessors added below record the constrained displacements, so the gold file checks
    # that they equal the welding-end values (last row of welding/gold/40mm/scl.csv). The five
    # *_haz / *_weld probes are the same as in weld_abbrev.
    type = CSVDiff
    working_directory = '../cooldown'
    input = 'cooldown.i'
    cli_args = "Executioner/num_steps=3 Outputs/exodus/enable=false
                Postprocessors/xzfix_bot_disp_x/type=PointValue Postprocessors/xzfix_bot_disp_x/variable=disp_x Postprocessors/xzfix_bot_disp_x/point='-75 450 0'
                Postprocessors/xzfix_bot_disp_z/type=PointValue Postprocessors/xzfix_bot_disp_z/variable=disp_z Postprocessors/xzfix_bot_disp_z/point='-75 450 0'
                Postprocessors/zfix_bot_disp_z/type=PointValue Postprocessors/zfix_bot_disp_z/variable=disp_z Postprocessors/zfix_bot_disp_z/point='75 450 0'
                Postprocessors/T_haz/type=PointValue Postprocessors/T_haz/variable=T Postprocessors/T_haz/point='-75.78 592.41 -5.96'
                Postprocessors/Svm_haz/type=PointValue Postprocessors/Svm_haz/variable=vonmises_stress Postprocessors/Svm_haz/point='-75.78 592.41 -5.96'
                Postprocessors/eps_p_haz/type=PointValue Postprocessors/eps_p_haz/variable=effective_plastic_strain Postprocessors/eps_p_haz/point='-75.78 592.41 -5.96'
                Postprocessors/T_weld/type=PointValue Postprocessors/T_weld/variable=T Postprocessors/T_weld/point='-75.78 598.68 -5.96'
                Postprocessors/eps_p_weld/type=PointValue Postprocessors/eps_p_weld/variable=effective_plastic_strain Postprocessors/eps_p_weld/point='-75.78 598.68 -5.96'"
    csvdiff = '40mm/scl.csv'
    rel_err = 1e-5
    abs_zero = 1e-9
    min_parallel = 12
    max_parallel = 12
    max_time = 600
    capabilities = 'method=opt & blackbearapp'
    prereq = 'cooldown_syntax'
  []
[]
