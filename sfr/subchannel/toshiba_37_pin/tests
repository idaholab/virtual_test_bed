[Tests]
  # Syntax Checks for 37-pin model
  [subchannel_syntax]
    type = RunApp
    input = toshiba_37_pin.i
    check_input = True
    capabilities = 'subchannelapp | combinedapp'
  []
  [viz_syntax]
    type = RunApp
    input = toshiba_37_pin_viz.i
    check_input = True
    capabilities = 'subchannelapp | combinedapp'
  []
  # Regression checks for 37-pin model
  [subchannel]
    type = CSVDiff
    input = toshiba_37_pin.i
    csvdiff = 'toshiba_37_pin_out.csv'
    prereq = 'subchannel_syntax'
    capabilities = 'method!=dbg & (subchannelapp | combinedapp)'
    valgrind = NONE
    recover = false
    abs_zero = 1e-5
    max_threads = 1
  []
[]
